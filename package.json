{
  "name": "vpnui",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented web panel for managing an OpenVPN server",
  "type": "module",
  "main": "backend/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "users": "node backend/cli/users.js"
  },
  "keywords": [
    "openvpn",
    "vpn",
    "panel"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "6.0.0",
    "compression": "1.8.2",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0"
  }
}
