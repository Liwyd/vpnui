#!/usr/bin/env bash
#
# vpnui — control CLI for the vpnui panel.
#
# Usage: vpnui <command>
#
set -euo pipefail

VERSION="1.0.0"
INSTALL_DIR="${VPNUI_DIR:-/opt/vpnui}"
LIB_DIR="${VPNUI_LIB:-/usr/local/lib/vpnui}"
ENV_FILE="$INSTALL_DIR/.env"

die() { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }
log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m⚠\033[0m %s\n' "$*"; }

usage() {
  cat <<'EOF'
vpnui — control CLI for the vpnui panel

Usage: vpnui <command>

Commands:
  install     (re)run the installer (idempotent)
  start       Start the panel container
  stop        Stop the panel container
  restart     Restart the panel container
  status      Container + health status
  logs        Follow panel logs (Ctrl-C to stop)
  update      Backup, update source, rebuild, restart, health-check
  backup      Create a backup archive (see vpnui backup --help)
  restore     Restore a backup archive (see vpnui restore --help)
  doctor      Run diagnostics with fix hints
  uninstall   Remove the panel (OpenVPN is left untouched unless --purge)
  version     Print CLI version
  help        Show this help
EOF
}

detect_compose() {
  if command -v docker >/dev/null && docker compose version >/dev/null 2>&1; then
    COMPOSE=(docker compose)
  elif command -v podman >/dev/null && podman compose version >/dev/null 2>&1; then
    COMPOSE=(podman compose)
  else
    die "no container engine with compose found (install docker or podman)"
  fi
}

compose() {
  detect_compose
  [[ -f "$INSTALL_DIR/docker-compose.yml" ]] ||
    die "panel not installed at $INSTALL_DIR (run: sudo vpnui install)"
  (cd "$INSTALL_DIR" && "${COMPOSE[@]}" "$@")
}

health_ok() {
  curl -fsS -m 3 http://127.0.0.1:3000/health >/dev/null 2>&1
}

cmd_status() {
  compose ps
  if health_ok; then
    ok "health: $(curl -fsS -m 3 http://127.0.0.1:3000/health)"
  else
    printf '\033[1;33m⚠\033[0m health: not responding on http://127.0.0.1:3000/health\n'
    exit 1
  fi
}

cmd_update() {
  [[ -f "$INSTALL_DIR/Dockerfile" ]] || die "panel not installed at $INSTALL_DIR"
  [[ -f "$LIB_DIR/backup.sh" ]] || die "backup script missing ($LIB_DIR/backup.sh)"

  log "creating pre-update backup"
  bash "$LIB_DIR/backup.sh" --quiet

  if [[ -d "$INSTALL_DIR/.git" ]]; then
    log "updating source (git pull)"
    git -C "$INSTALL_DIR" pull --ff-only
  elif [[ -n "${VPNUI_SOURCE:-}" && -d "$VPNUI_SOURCE" ]]; then
    log "updating source from $VPNUI_SOURCE"
    for item in Dockerfile docker-compose.yml package.json package-lock.json backend public scripts; do
      [[ -e "$VPNUI_SOURCE/$item" ]] || continue
      rm -rf "${INSTALL_DIR:?}/$item"
      cp -a "$VPNUI_SOURCE/$item" "$INSTALL_DIR/"
    done
  else
    warn "no git repo or VPNUI_SOURCE set — rebuilding with the current source tree"
  fi

  log "rebuilding image"
  compose build
  log "restarting panel"
  compose up -d

  log "health check"
  for _ in $(seq 1 45); do
    if health_ok; then
      ok "update complete — panel healthy"
      compose ps
      return 0
    fi
    sleep 1
  done
  compose logs --tail 40 || true
  die "update finished but the panel is not healthy — inspect logs above; pre-update backup is in /var/backups/vpnui/"
}

cmd_uninstall() {
  PURGE=0
  [[ "${1:-}" == "--purge" ]] && PURGE=1
  if [[ -f "$INSTALL_DIR/docker-compose.yml" ]]; then
    log "stopping panel container"
    compose down 2>/dev/null || true
  fi
  rm -f "$CLI_LINK"
  rm -rf "$LIB_DIR"
  if [[ $PURGE -eq 1 ]]; then
    log "removing $INSTALL_DIR and /var/lib/vpnui"
    rm -rf "$INSTALL_DIR" /var/lib/vpnui
    ok "panel fully removed (source, data and panel state deleted)"
    warn "OpenVPN was NOT removed — to remove it too: sudo $INSTALL_DIR/scripts/vendor/openvpn-install.sh uninstall (or openvpn-install uninstall)"
  else
    ok "panel removed (source kept at $INSTALL_DIR; /var/lib/vpnui data untouched)"
    warn "to also remove OpenVPN: openvpn-install uninstall"
  fi
}

CMD="${1:-help}"
[[ $# -gt 0 ]] && shift || true

case "$CMD" in
install)
  [[ -x "$INSTALL_DIR/scripts/install.sh" ]] && exec bash "$INSTALL_DIR/scripts/install.sh" "$@" ||
    die "installer not found at $INSTALL_DIR/scripts/install.sh"
  ;;
start) compose up -d ;;
stop) compose stop ;;
restart) compose restart ;;
status) cmd_status ;;
logs) compose logs -f --tail 200 ;;
update) cmd_update ;;
backup) exec bash "$LIB_DIR/backup.sh" "$@" ;;
restore) exec bash "$LIB_DIR/restore.sh" "$@" ;;
doctor) exec bash "$LIB_DIR/doctor.sh" "$@" ;;
uninstall) cmd_uninstall "${1:-}" ;;
version) echo "vpnui $VERSION" ;;
help | -h | --help) usage ;;
*) die "unknown command: $CMD (see: vpnui help)" ;;
esac
