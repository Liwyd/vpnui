#!/usr/bin/env bash
#
# vpnui — control CLI for the vpnui panel.
#
# Usage: vpnui <command>
#
set -euo pipefail

VERSION="1.1.0"
INSTALL_DIR="${VPNUI_DIR:-/opt/vpnui}"
LIB_DIR="${VPNUI_LIB:-/usr/local/lib/vpnui}"
CLI_LINK="${VPNUI_CLI_LINK:-/usr/local/bin/vpnui}"
DATA_DIR="${VPNUI_DATA_DIR:-/var/lib/vpnui}"
BACKUP_DIR="${VPNUI_BACKUP_DIR:-/var/backups/vpnui}"
PANEL_CONTAINER="${VPNUI_CONTAINER:-vpnui}"

COMPOSE=()
ENGINE=""
COMPOSE_DETECTED=0

die() { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }
log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m⚠\033[0m %s\n' "$*"; }

usage() {
  cat <<'EOF'
vpnui — control CLI for the vpnui panel

Usage: vpnui <command>

Commands:
  install     (re)run the installer (idempotent, prompts when a TTY is attached)
  start       Start the panel container
  stop        Stop the panel container
  restart     Restart the panel container
  status      Container + health status
  logs        Follow panel logs (Ctrl-C to stop)
  update      Backup → pull new image (or rebuild) → restart → health check
              → prune the old image. Rolls back automatically if unhealthy.
              Panel data is never touched.
  backup      Create a backup archive (see vpnui backup --help)
  restore     Restore a backup archive (see vpnui restore --help)
  user        Manage panel accounts: vpnui user add|list|reset|delete <name>
  doctor      Run diagnostics with fix hints
  uninstall   Stop the container, remove CLI/scripts (keeps source, data,
              images). Add --purge to delete everything: container, images,
              install dir, data dir, CLI and the OpenVPN server installation
              (--keep-openvpn keeps OpenVPN; --delete-backups also drops
              /var/backups/vpnui).
  version     Print CLI version
  help        Show this help
EOF
}

env_get() { # env_get FILE KEY -> value (empty when absent)
  grep "^$2=" "$1" 2>/dev/null | head -1 | cut -d= -f2- || true
}

podman_socket_ok() {
  local sock
  sock="$(podman info --format '{{.Host.RemoteSocket.Path}}' 2>/dev/null || true)"
  [[ -n "$sock" && -S "$sock" ]]
}

detect_compose() {
  [[ $COMPOSE_DETECTED -eq 1 ]] && return 0
  COMPOSE_DETECTED=1
  if [[ -n "${VPNUI_COMPOSE:-}" ]]; then
    read -ra COMPOSE <<<"$VPNUI_COMPOSE"
    if [[ "${COMPOSE[0]}" == "docker" || "${COMPOSE[0]}" == "podman" ]]; then
      ENGINE="${COMPOSE[0]}"
    fi
  elif command -v docker >/dev/null && docker compose version >/dev/null 2>&1 &&
    docker info >/dev/null 2>&1; then
    COMPOSE=(docker compose)
    ENGINE=docker
  elif command -v podman >/dev/null && podman compose version >/dev/null 2>&1 &&
    podman info >/dev/null 2>&1; then
    if podman_socket_ok; then
      COMPOSE=(podman compose)
      ENGINE=podman
    else
      # compose talks to podman through its API socket — try to start it
      if [[ $EUID -eq 0 ]]; then systemctl start podman.socket >/dev/null 2>&1 || true
      else systemctl --user start podman.socket >/dev/null 2>&1 || true
      fi
      sleep 1
      if podman_socket_ok; then
        COMPOSE=(podman compose)
        ENGINE=podman
      else
        COMPOSE=()
        COMPOSE_HINT="podman's API socket is not running — start it: systemctl --user start podman.socket (rootful: sudo systemctl start podman.socket)"
      fi
    fi
  fi
  if [[ -z "$ENGINE" ]]; then
    if command -v docker >/dev/null && docker info >/dev/null 2>&1; then ENGINE=docker
    elif command -v podman >/dev/null && podman info >/dev/null 2>&1; then ENGINE=podman
    fi
  fi
  [[ ${#COMPOSE[@]} -gt 0 ]] || return 1
  return 0
}

compose() {
  detect_compose || die "no running container engine with compose found${COMPOSE_HINT:+ — $COMPOSE_HINT}"
  [[ -f "$INSTALL_DIR/docker-compose.yml" ]] ||
    die "panel not installed at $INSTALL_DIR (run: sudo vpnui install)"
  (cd "$INSTALL_DIR" && "${COMPOSE[@]}" "$@")
}

# Panel URL derived from .env (VPNUI_BIND/PANEL_PORT); VPNUI_URL overrides.
panel_url() {
  local url="${VPNUI_URL:-}" bind port host
  if [[ -n "$url" ]]; then
    printf '%s' "$url"
    return 0
  fi
  bind="$(env_get "$INSTALL_DIR/.env" VPNUI_BIND)"
  port="$(env_get "$INSTALL_DIR/.env" PANEL_PORT)"
  [[ "$port" =~ ^[0-9]{1,5}$ ]] || port=3000
  case "$bind" in
  "" | 127.0.0.1 | 0.0.0.0) host="127.0.0.1" ;;
  *) host="$bind" ;;
  esac
  printf 'http://%s:%s' "$host" "$port"
}

detect_public_ip() {
  local ip=""
  for url in https://api.ipify.org https://ifconfig.me/ip https://icanhazip.com; do
    ip="$(curl -4 -fsS -m 4 "$url" 2>/dev/null | tr -d '[:space:]' || true)"
    [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] && { printf '%s' "$ip"; return 0; }
  done
  ip="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
  [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] && { printf '%s' "$ip"; return 0; }
  return 1
}

health_ok() {
  curl -fsS -m 3 "$(panel_url)/health" >/dev/null 2>&1
}

wait_healthy() { # wait_healthy SECONDS
  local tries="$1" _
  for _ in $(seq 1 "$tries"); do
    health_ok && return 0
    sleep 1
  done
  return 1
}

container_image_id() {
  local cid=""
  [[ $COMPOSE_DETECTED -eq 1 && -n "$ENGINE" ]] || return 0
  cid="$(compose ps -q vpnui 2>/dev/null | head -1 || true)"
  [[ -n "$cid" ]] || return 0
  "$ENGINE" inspect --format '{{.Image}}' "$cid" 2>/dev/null || true
}

cmd_status() {
  compose ps
  if health_ok; then
    ok "health: $(curl -fsS -m 3 "$(panel_url)/health")"
  else
    printf '\033[1;33m⚠\033[0m health: not responding on %s/health\n' "$(panel_url)"
    exit 1
  fi
  local bind port
  bind="$(env_get "$INSTALL_DIR/.env" VPNUI_BIND)"
  port="$(env_get "$INSTALL_DIR/.env" PANEL_PORT)"
  [[ "$port" =~ ^[0-9]{1,5}$ ]] || port=3000
  if [[ "$bind" == "0.0.0.0" ]]; then
    local ip
    ip="$(detect_public_ip || true)"
    ip="${ip:-<server-ip>}"
    printf '      panel: http://%s:%s (direct access)\n' "$ip" "$port"
  fi
}

cmd_update() {
  [[ -f "$INSTALL_DIR/Dockerfile" ]] || die "panel not installed at $INSTALL_DIR"
  [[ -f "$LIB_DIR/backup.sh" ]] || die "backup script missing ($LIB_DIR/backup.sh)"
  detect_compose || die "no running container engine with compose found"
  local env_file="$INSTALL_DIR/.env"

  log "creating pre-update backup"
  bash "$LIB_DIR/backup.sh" --quiet

  local image="" registry_mode=0 old_id=""
  if grep -q '^IMAGE_NAME=' "$env_file" 2>/dev/null; then
    registry_mode=1
    image="$(env_get "$env_file" IMAGE_NAME)"
  fi

  # Remember the image the panel runs right now (for prune + rollback).
  old_id="$(container_image_id)"

  local fail_reason=""
  if [[ $registry_mode -eq 1 ]]; then
    log "pulling $image"
    compose pull || warn "pull failed — continuing with the images already present"
    log "restarting panel (data in $DATA_DIR is never touched)"
    compose up -d --no-build || fail_reason="the container failed to start"
  else
    if [[ -d "$INSTALL_DIR/.git" ]]; then
      log "updating source (git pull)"
      git -C "$INSTALL_DIR" pull --ff-only
    elif [[ -n "${VPNUI_SOURCE:-}" && -d "$VPNUI_SOURCE" ]]; then
      log "updating source from $VPNUI_SOURCE"
      local item
      for item in Dockerfile docker-compose.yml package.json package-lock.json backend public scripts; do
        [[ -e "$VPNUI_SOURCE/$item" ]] || continue
        rm -rf "${INSTALL_DIR:?}/$item"
        cp -a "$VPNUI_SOURCE/$item" "$INSTALL_DIR/"
      done
    else
      warn "no git repo or VPNUI_SOURCE set — rebuilding with the current source tree"
    fi

    log "rebuilding image (data in $DATA_DIR is never touched)"
    if ! compose build; then
      die "build failed — the panel keeps running on the previous image (backup in $BACKUP_DIR/)"
    fi
    compose up -d || fail_reason="the container failed to start"
  fi

  if [[ -z "$fail_reason" ]]; then
    log "health check ($(panel_url))"
    wait_healthy 45 || fail_reason="the panel is not healthy after 45s"
  fi

  if [[ -z "$fail_reason" ]]; then
    prune_old_image "$old_id"
    ok "update complete — panel healthy"
    compose ps
    return 0
  fi

  compose logs --tail 40 || true
  warn "update failed: $fail_reason — rolling back to the previous image"
  local rollback_ok=0 target="$image"
  [[ $registry_mode -eq 0 ]] && target="vpnui:local"
  if [[ -n "$old_id" && -n "$ENGINE" ]] &&
    "$ENGINE" tag "$old_id" "$target" 2>/dev/null &&
    compose up -d --no-build >/dev/null 2>&1; then
    if wait_healthy 30; then
      rollback_ok=1
      warn "rolled back — the panel is healthy on the previous image again"
    fi
  fi
  if [[ $rollback_ok -eq 1 ]]; then
    die "update FAILED ($fail_reason) — rolled back to the previous image; backup in $BACKUP_DIR/"
  fi
  die "update FAILED ($fail_reason) and rollback did not succeed — inspect logs above; backup in $BACKUP_DIR/"
}

prune_old_image() { # prune_old_image OLD_IMAGE_ID
  local old="$1" new_id=""
  [[ -n "$old" && -n "$ENGINE" ]] || return 0
  new_id="$(container_image_id)"
  if [[ -z "$new_id" || "$old" == "$new_id" ]]; then
    ok "image already up to date (nothing to prune)"
    return 0
  fi
  if "$ENGINE" rmi "$old" >/dev/null 2>&1; then
    ok "pruned the previous image (${old:0:25}…)"
  else
    warn "previous image still referenced elsewhere — left in place"
  fi
}

# --- openvpn removal (purge only) -------------------------------------------
# The vendored angristan script performs the complete cleanup for the
# standard layout (service, firewall, sysctl, package, /etc/openvpn).
# A custom VPNUI_OVPN_HOST_DIR layout (test fixture) is only removed as a
# directory — no services, packages or firewall rules are involved.
OPENVPN_RESULT="" # removed | none | kept
OPENVPN_REASON=""

openvpn_purge() {
  local dir="${VPNUI_OPENVPN_DIR:-${VPNUI_OVPN_HOST_DIR:-/etc/openvpn/server}}"
  local vendor="$INSTALL_DIR/scripts/vendor/openvpn-install.sh"
  dir="${dir%/}"

  if [[ "${VPNUI_KEEP_OPENVPN:-0}" == "1" ]]; then
    OPENVPN_RESULT=kept
    OPENVPN_REASON="VPNUI_KEEP_OPENVPN=1"
    return 0
  fi
  if [[ ! -f "$dir/server.conf" ]]; then
    OPENVPN_RESULT=none
    return 0
  fi

  if [[ "$dir" == "/etc/openvpn/server" ]]; then
    if [[ $EUID -ne 0 ]]; then
      OPENVPN_RESULT=kept
      OPENVPN_REASON="needs root — rerun the purge as root"
      return 0
    fi
    log "removing the OpenVPN server installation"
    if [[ -f "$vendor" ]]; then
      # The vendored script may exit non-zero after a successful removal
      # (its last step is 'apt-get update') — the files decide success.
      bash "$vendor" uninstall --force ||
        warn "the OpenVPN uninstaller reported errors (removal is verified below)"
    else
      warn "vendored OpenVPN uninstaller missing — removing manually"
      systemctl disable --now openvpn-server@server 2>/dev/null || true
      systemctl disable --now openvpn 2>/dev/null || true
      rm -rf /etc/openvpn
      if command -v apt-get >/dev/null; then
        apt-get remove --purge -y openvpn || warn "could not remove the openvpn package"
      elif command -v dnf >/dev/null; then
        dnf remove -y openvpn || warn "could not remove the openvpn package"
      elif command -v yum >/dev/null; then
        yum remove -y openvpn || warn "could not remove the openvpn package"
      fi
    fi
  else
    log "removing the OpenVPN server data at $dir"
    rm -rf "$dir"
  fi

  if [[ -f "$dir/server.conf" ]]; then
    OPENVPN_RESULT=kept
    OPENVPN_REASON="files still present at $dir"
  else
    OPENVPN_RESULT=removed
  fi
}

cmd_uninstall() {
  local purge=0 delete_backups=0 keep_openvpn=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --purge) purge=1 ;;
    --keep-openvpn) keep_openvpn=1 ;;
    --delete-backups) delete_backups=1 ;;
    -h | --help)
      echo "Usage: vpnui uninstall [--purge] [--keep-openvpn] [--delete-backups]"
      echo
      echo "  (default)          stop container + network, remove CLI and helper"
      echo "                     scripts; source, data, backups and images are kept"
      echo "  --purge            also delete images, $INSTALL_DIR, $DATA_DIR and the"
      echo "                     OpenVPN server installation (service, firewall,"
      echo "                     sysctl and package via the vendored uninstaller)"
      echo "  --keep-openvpn     with --purge: keep the OpenVPN server installation"
      echo "  --delete-backups   with --purge: also delete $BACKUP_DIR"
      echo "  Without --purge, OpenVPN is never touched."
      exit 0
      ;;
    *) die "unknown option for uninstall: $1 (see: vpnui uninstall --help)" ;;
    esac
    shift
  done
  if [[ $keep_openvpn -eq 1 && $purge -eq 0 ]]; then
    die "--keep-openvpn only makes sense with --purge"
  fi

  local env_file="$INSTALL_DIR/.env" compose_file="$INSTALL_DIR/docker-compose.yml"
  local image="" cid="" old_id="" engine_ok=0
  local -a check_refs=()

  if [[ -f "$compose_file" ]]; then
    if detect_compose; then
      engine_ok=1
      image="$(env_get "$env_file" IMAGE_NAME)"
      cid="$(compose ps -q --all vpnui 2>/dev/null | head -1 || true)"
      if [[ -n "$cid" && -n "$ENGINE" ]]; then
        old_id="$("$ENGINE" inspect --format '{{.Image}}' "$cid" 2>/dev/null || true)"
      fi
      log "stopping panel container and network"
      compose down --remove-orphans >/dev/null 2>&1 ||
        warn "compose down reported problems (continuing with verification)"
    else
      warn "no container engine available — skipping container/image cleanup"
    fi
  fi

  # Podman stores unqualified names (vpnui:local) under localhost/ — track both
  # spellings so inspection, removal and verification see the same image.
  add_ref() {
    local r="$1"
    [[ -n "$r" && -n "$ENGINE" ]] || return 0
    check_refs+=("$r")
    if [[ "$ENGINE" == "podman" && "$r" != */* ]] &&
      "$ENGINE" image inspect "localhost/$r" >/dev/null 2>&1; then
      check_refs+=("localhost/$r")
    fi
  }

  if [[ $purge -eq 1 && $engine_ok -eq 1 && -n "$ENGINE" ]]; then
    log "removing vpnui images"
    local ref removed=0
    for ref in "$image" "vpnui:local" "$old_id"; do
      add_ref "$ref"
    done
    for ref in "${check_refs[@]+"${check_refs[@]}"}"; do
      if "$ENGINE" image inspect "$ref" >/dev/null 2>&1; then
        if "$ENGINE" rmi "$ref" >/dev/null 2>&1; then
          removed=$((removed + 1))
        fi
      fi
    done
    ok "images processed ($removed removed, already-missing images skipped)"
  elif [[ $engine_ok -eq 1 ]]; then
    # Soft uninstall keeps images (fast reinstall); record them for verification.
    local ref
    for ref in "$image" "vpnui:local" "$old_id"; do
      add_ref "$ref"
    done
  fi

  log "removing the vpnui command and helper scripts"
  rm -f "$CLI_LINK" 2>/dev/null || true
  rm -rf "$LIB_DIR" 2>/dev/null || true

  if [[ $purge -eq 1 ]]; then
    # OpenVPN first — the vendored uninstaller lives in $INSTALL_DIR.
    if [[ $keep_openvpn -eq 1 ]]; then
      OPENVPN_RESULT=kept
      OPENVPN_REASON="--keep-openvpn"
    else
      openvpn_purge
    fi
    log "removing $INSTALL_DIR and $DATA_DIR"
    rm -rf "$INSTALL_DIR" "$DATA_DIR" 2>/dev/null || true
    if [[ $delete_backups -eq 1 ]]; then
      log "removing $BACKUP_DIR"
      rm -rf "$BACKUP_DIR" 2>/dev/null || true
    fi
  fi

  # -------------------------------------------------------------------------
  # Verification — prove nothing was left behind.
  # -------------------------------------------------------------------------
  VERIFIED_FAILED=0
  v_ok() { printf '  \033[1;32m✓\033[0m %s\n' "$1"; }
  v_fail() {
    printf '  \033[1;31m✗\033[0m %s\n' "$1"
    VERIFIED_FAILED=1
  }
  echo
  echo "Verification:"

  if [[ $engine_ok -eq 1 && -n "$ENGINE" && -n "$cid" ]]; then
    if "$ENGINE" inspect "$cid" >/dev/null 2>&1; then
      v_fail "container still exists (id ${cid:0:12}…)"
    else
      v_ok "container removed"
    fi
  else
    v_ok "container removed (none found)"
  fi

  local ref
  for ref in "${check_refs[@]+"${check_refs[@]}"}"; do
    [[ -n "$ENGINE" ]] || break
    if "$ENGINE" image inspect "$ref" >/dev/null 2>&1; then
      if [[ $purge -eq 1 ]]; then
        v_fail "image still present: $ref"
      else
        v_ok "image kept: $ref"
      fi
    elif [[ $purge -eq 1 ]]; then
      v_ok "image removed: $ref"
    fi
  done
  if [[ $purge -eq 0 && $engine_ok -eq 1 ]]; then
    v_ok "images kept by default (use --purge to delete them)"
  fi

  if [[ $purge -eq 1 ]]; then
    case "$OPENVPN_RESULT" in
    removed) v_ok "OpenVPN installation removed" ;;
    none) v_ok "no OpenVPN installation found (nothing to remove)" ;;
    kept)
      if [[ "$OPENVPN_REASON" == "--keep-openvpn" || "$OPENVPN_REASON" == "VPNUI_KEEP_OPENVPN=1" ]]; then
        v_ok "OpenVPN kept ($OPENVPN_REASON)"
      else
        v_fail "OpenVPN kept: $OPENVPN_REASON"
      fi
      ;;
    esac
  else
    v_ok "OpenVPN untouched (remove with: vpnui uninstall --purge)"
  fi

  if [[ -e "$CLI_LINK" ]]; then v_fail "command still on PATH: $CLI_LINK"; else v_ok "command removed: $CLI_LINK"; fi
  if [[ -e "$LIB_DIR" ]]; then v_fail "helper scripts still present: $LIB_DIR"; else v_ok "helper scripts removed: $LIB_DIR"; fi

  if [[ $purge -eq 1 ]]; then
    if [[ -e "$INSTALL_DIR" ]]; then v_fail "install dir still present: $INSTALL_DIR"; else v_ok "install dir removed: $INSTALL_DIR"; fi
    if [[ -e "$DATA_DIR" ]]; then v_fail "data dir still present: $DATA_DIR"; else v_ok "data dir removed: $DATA_DIR"; fi
    if [[ $delete_backups -eq 1 ]]; then
      if [[ -e "$BACKUP_DIR" ]]; then v_fail "backups still present: $BACKUP_DIR"; else v_ok "backups removed: $BACKUP_DIR"; fi
    elif [[ -d "$BACKUP_DIR" ]]; then
      v_ok "backups kept at $BACKUP_DIR (--delete-backups to remove)"
    fi
  else
    if [[ -e "$INSTALL_DIR" ]]; then v_ok "source kept at $INSTALL_DIR"; else v_fail "source missing: $INSTALL_DIR"; fi
    if [[ -e "$DATA_DIR" ]]; then v_ok "panel data kept at $DATA_DIR"; else v_fail "data missing: $DATA_DIR"; fi
  fi

  echo
  if [[ $VERIFIED_FAILED -eq 1 ]]; then
    die "uninstall incomplete — the ✗ items above could not be removed (need root?)"
  fi
  if [[ $purge -eq 1 ]]; then
    ok "verified: no trace of the vpnui panel remains"
    if [[ "$OPENVPN_RESULT" == "kept" ]]; then
      warn "OpenVPN kept ($OPENVPN_REASON) — to remove it too: vpnui uninstall --purge"
    fi
  else
    ok "verified: container, command and scripts removed"
    warn "reinstall with: sudo bash $INSTALL_DIR/scripts/install.sh   (full removal incl. OpenVPN: vpnui uninstall --purge)"
  fi
}

# --- user management ---------------------------------------------------------
# Panel accounts live in $DATA_DIR/users.json (bind-mounted). The management
# CLI (backend/cli/users.js) runs inside the container where deps are baked in.

user_prepare() {
  if [[ -z "$ENGINE" ]]; then
    detect_compose || true
  fi
  [[ -n "$ENGINE" ]] || die "no container engine found (docker/podman)"
  "$ENGINE" info >/dev/null 2>&1 || die "$ENGINE is not running — start the daemon first"
  local running
  running="$("$ENGINE" inspect -f '{{.State.Running}}' "$PANEL_CONTAINER" 2>/dev/null || true)"
  [[ "$running" == "true" ]] || die "panel container is not running — start it: vpnui start"
}

user_exec() { # user_exec ARGS... — run the in-container user CLI
  local -a tty=(-i)
  if [[ -t 0 && -t 1 ]]; then
    tty+=(-t)
  fi
  "$ENGINE" exec ${tty[@]+"${tty[@]}"} "$PANEL_CONTAINER" node backend/cli/users.js "$@"
}

user_usage() {
  cat <<EOF
Usage: vpnui user <add|list|reset|delete> ...

  vpnui user list
      List panel accounts (username, role, created, last login).

  vpnui user add <username> [--role ROLE] [--password PASS]
      Create an account. Roles: admin, operator, user, readonly.
      Without --password/--role the container prompts interactively.

  vpnui user reset <username> [--password PASS]
      Reset an account's password (prompts when a TTY is attached).

  vpnui user delete <username> [--yes]
      Delete an account (asks for confirmation on a TTY).

Notes:
  - Runs inside the panel container against $DATA_DIR/users.json.
  - Prefer the interactive prompt over --password: flags are visible to
    other local users in process listings.
  - Changing a role later is only available via the API (PUT /api/users/:name).
EOF
}

cmd_user() {
  local sub="${1:-help}"
  if [[ $# -gt 0 ]]; then
    shift
  fi
  case "$sub" in
  list)
    [[ $# -eq 0 ]] || die "usage: vpnui user list"
    user_prepare
    user_exec list
    ;;
  add)
    local username="" role="" password=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
      --role)
        [[ $# -ge 2 ]] || die "--role requires a value"
        role="$2"
        shift 2
        ;;
      --password)
        [[ $# -ge 2 ]] || die "--password requires a value"
        password="$2"
        shift 2
        ;;
      --username)
        [[ $# -ge 2 ]] || die "--username requires a value"
        username="$2"
        shift 2
        ;;
      -*) die "unknown option for user add: $1 (see: vpnui user --help)" ;;
      *)
        [[ -z "$username" ]] || die "unexpected argument: $1"
        username="$1"
        shift
        ;;
      esac
    done
    [[ -n "$username" ]] || die "usage: vpnui user add <username> [--role ROLE] [--password PASS]"
    if [[ ! -t 0 ]]; then
      [[ -n "$password" ]] || die "no TTY attached — pass --password (or run interactively)"
      [[ -n "$role" ]] || die "no TTY attached — pass --role admin|operator|user|readonly"
    fi
    user_prepare
    local -a args=(create --username "$username")
    if [[ -n "$role" ]]; then args+=(--role "$role"); fi
    if [[ -n "$password" ]]; then args+=(--password "$password"); fi
    user_exec "${args[@]}"
    ok "user \"$username\" created"
    ;;
  reset)
    local username="" password=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
      --password)
        [[ $# -ge 2 ]] || die "--password requires a value"
        password="$2"
        shift 2
        ;;
      --username)
        [[ $# -ge 2 ]] || die "--username requires a value"
        username="$2"
        shift 2
        ;;
      -*) die "unknown option for user reset: $1 (see: vpnui user --help)" ;;
      *)
        [[ -z "$username" ]] || die "unexpected argument: $1"
        username="$1"
        shift
        ;;
      esac
    done
    [[ -n "$username" ]] || die "usage: vpnui user reset <username> [--password PASS]"
    if [[ ! -t 0 && -z "$password" ]]; then
      die "no TTY attached — pass --password (or run interactively)"
    fi
    user_prepare
    local -a args=(reset-password --username "$username")
    if [[ -n "$password" ]]; then args+=(--password "$password"); fi
    user_exec "${args[@]}"
    ok "password reset for \"$username\""
    ;;
  delete)
    local username="" yes=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
      --yes) yes=1 ;;
      --username)
        [[ $# -ge 2 ]] || die "--username requires a value"
        username="$2"
        shift 2
        ;;
      -*) die "unknown option for user delete: $1 (see: vpnui user --help)" ;;
      *)
        [[ -z "$username" ]] || die "unexpected argument: $1"
        username="$1"
        shift
        ;;
      esac
    done
    [[ -n "$username" ]] || die "usage: vpnui user delete <username> [--yes]"
    if [[ -t 0 && $yes -eq 0 ]]; then
      local reply=""
      read -r -p "Delete user \"$username\"? [y/N] " reply || die "aborted"
      [[ "$reply" =~ ^[Yy] ]] || die "aborted"
    fi
    user_prepare
    user_exec delete --username "$username"
    ok "user \"$username\" deleted"
    ;;
  help | -h | --help)
    user_usage
    ;;
  *)
    die "unknown user subcommand: $sub (see: vpnui user --help)"
    ;;
  esac
}

run_helper() { # run_helper NAME [args...]
  local name="$1"
  shift
  [[ -f "$LIB_DIR/$name" ]] || die "$name not found ($LIB_DIR/$name) — reinstall: sudo vpnui install"
  exec bash "$LIB_DIR/$name" "$@"
}

CMD="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$CMD" in
install)
  if [[ -f "$INSTALL_DIR/scripts/install.sh" ]]; then
    exec bash "$INSTALL_DIR/scripts/install.sh" "$@"
  fi
  die "installer not found at $INSTALL_DIR/scripts/install.sh"
  ;;
start) compose up -d ;;
stop) compose stop ;;
restart) compose restart ;;
status) cmd_status ;;
logs) compose logs -f --tail 200 ;;
update) cmd_update ;;
backup) run_helper backup.sh "$@" ;;
restore) run_helper restore.sh "$@" ;;
user) cmd_user "$@" ;;
doctor) run_helper doctor.sh "$@" ;;
uninstall) cmd_uninstall "$@" ;;
version) echo "vpnui $VERSION" ;;
help | -h | --help) usage ;;
*) die "unknown command: $CMD (see: vpnui help)" ;;
esac
