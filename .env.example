# VPNUI configuration — copy to .env and adjust.
# NEVER commit the real .env file.

# --- Core -------------------------------------------------------------------
# HTTP listen port
PORT=3000

# Host-facing listen settings written by the installer and interpolated by
# docker-compose.yml (host port + published address).
#   VPNUI_BIND: 127.0.0.1 (loopback, reverse proxy) or 0.0.0.0 (direct)
#   PANEL_PORT: published port; also passed to the app as PORT above
# VPNUI_BIND=127.0.0.1
# PANEL_PORT=3000

# Custom host directories for the bind mounts (defaults match the standard
# layout; set these for non-standard OpenVPN/data locations or test setups).
# VPNUI_OVPN_HOST_DIR=/etc/openvpn/server
# VPNUI_DATA_HOST_DIR=/var/lib/vpnui

# Panel image used by docker compose. The installer sets this to the
# published registry image when it can be pulled (liwyd/vpnui:latest);
# leave it unset to build the image locally from this source tree.
# IMAGE_NAME=liwyd/vpnui:latest

# development | production (production hides stack traces)
NODE_ENV=production

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Authentication ---------------------------------------------------------
# REQUIRED — no default. Generate with:  openssl rand -hex 32
JWT_SECRET=

# Token lifetime (s, m, h, d, w)
JWT_EXPIRES_IN=12h

# Bcrypt cost (10-15)
BCRYPT_ROUNDS=12

# --- Bootstrap admin (optional) ---------------------------------------------
# If set AND no users exist yet, an admin account is created on first start.
# The installer generates these, prints the password once, then removes them.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- OpenVPN locations ------------------------------------------------------
# Explicit configuration always wins over discovery. Defaults work with the
# modern layout (/etc/openvpn/server/...) and fall back to the legacy one.
# OPENVPN_DIR=/etc/openvpn
# OPENVPN_SERVER_DIR=/etc/openvpn/server
# SERVER_CONF=/etc/openvpn/server/server.conf
# EASY_RSA_DIR=/etc/openvpn/server/easy-rsa
# INDEX_FILE=/etc/openvpn/server/easy-rsa/pki/index.txt
# CLIENT_TEMPLATE=/etc/openvpn/server/client-template.txt

# Public endpoint shown in the dashboard (otherwise read from the client template)
# SERVER_ENDPOINT=vpn.example.com

# Optional observability mounts (read-only)
# STATUS_FILE=/var/log/openvpn/status.log
# MGMT_SOCKET=/var/run/openvpn-server/server.sock

# --- Application data -------------------------------------------------------
# DATA_DIR=/var/lib/vpnui
# CLIENT_CONFIG_DIR=/var/lib/vpnui/clients
# USERS_FILE=/var/lib/vpnui/users.json
# AUDIT_LOG_FILE=/var/lib/vpnui/audit.log

# --- Behaviour --------------------------------------------------------------
# Client certificate validity (days) and CRL validity (days)
# CLIENT_CERT_DAYS=3650
# CRL_DAYS=5475

# External command timeout in ms
# COMMAND_TIMEOUT_MS=120000

# Rate limiting (set RATE_LIMIT_ENABLED=false only for local testing)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_GLOBAL_MAX=600

# Set to 1 when behind a reverse proxy (required for correct client IPs)
# TRUST_PROXY=1
